internal partial module adm.network.s3.wire {
	use (
		std.crypto.hash
		std.net.http
		std.net.http.httptest
		std.os
		std.testing
		std.time
		adm.network.s3::*
	)

	// An S3 server that also answers STS, as for ADM_TEST_S3.
	@env("ADM_TEST_S3")
	internal const testStore string

	// Sources that read their environment from a map and their files from
	// a folder of the test's own.
	internal def fakeSources(vars map<string, string>, home string) Sources {
		return Sources{env: def (name string) ?string {
			return vars.get(name)
		}, home: home, patience: 2s, run: def (command string) !(string, int) {
			// A stand-in for the shell: it knows one program.
			fail "no such program" unless command.startsWith("vault-helper ")
			return ("\{\"Version\":1,\"AccessKeyId\":\"ASIAPROC\",\"SecretAccessKey\":\"proc-secret\",\"SessionToken\":\"proc-token\",\"Expiration\":\"2099-01-01T00:00:00Z\"}", command.endsWith("--fail") ?? (3, 0))
		}}
	}

	internal def failureKind(err error) ErrorKind {
		return err.kind when err is S3Error
		return ErrorKind.Server
	}

	check "Credentials" {
		@test()
		def TestEnvironmentAndFiles() !none {
			let home = "/tmp/adm-s3-home-{time.now().unixNs()}"
			try os.mkdir("{home}/.aws", true)
			let off = {"AWS_EC2_METADATA_DISABLED": "true"}

			let kind = ErrorKind.Server
			let said = ""
			findKeys(fakeSources(off, home), "") onerror (err error) {
				kind = failureKind(err)
				said = err.message
				recover Found{}
			}
			assert kind == ErrorKind.Denied && said.contains("AWS_ACCESS_KEY_ID") && said.contains("profile 'default'")

			let env = {"AWS_ACCESS_KEY_ID": "AKIAENV", "AWS_SECRET_ACCESS_KEY": "env-secret", "AWS_SESSION_TOKEN": "env-token", "AWS_DEFAULT_REGION": "eu-west-3"}
			let fromEnv = try findKeys(fakeSources(env, home), "")
			assert fromEnv.keys.accessKey == "AKIAENV" && fromEnv.keys.secretKey == "env-secret" && fromEnv.keys.token == "env-token"
			assert fromEnv.region == "eu-west-3" && fromEnv.renew is none && fromEnv.keys.expires is none

			try os.writeFile("{home}/.aws/credentials", "[default]\naws_access_key_id = AKIAFILE\naws_secret_access_key = file-secret\n\n[work]\naws_access_key_id=AKIAWORK\naws_secret_access_key=work-secret\naws_session_token=work-token\n".bytes())
			try os.writeFile("{home}/.aws/config", "[default]\nregion = eu-central-1\n\n[profile work]\nregion = ap-south-1\n\n[profile inline]\naws_access_key_id = AKIAINLINE\naws_secret_access_key = inline-secret\n".bytes())
			let fromFile = try findKeys(fakeSources(off, home), "")
			assert fromFile.keys.accessKey == "AKIAFILE" && fromFile.keys.secretKey == "file-secret" && fromFile.region == "eu-central-1"
			let work = try findKeys(fakeSources(off, home), "work")
			assert work.keys.accessKey == "AKIAWORK" && work.keys.token == "work-token" && work.region == "ap-south-1"
			let named = try findKeys(fakeSources({"AWS_PROFILE": "inline", "AWS_EC2_METADATA_DISABLED": "true"}, home), "")
			assert named.keys.accessKey == "AKIAINLINE" && named.region == ""
			// The environment's region wins over the profile's.
			let mixed = try findKeys(fakeSources({"AWS_REGION": "us-west-2", "AWS_EC2_METADATA_DISABLED": "true"}, home), "work")
			assert mixed.region == "us-west-2" && mixed.keys.accessKey == "AKIAWORK"
			// Files named by the environment.
			try os.writeFile("{home}/elsewhere", "[default]\naws_access_key_id = AKIAELSE\naws_secret_access_key = else-secret\n".bytes())
			let moved = try findKeys(fakeSources({"AWS_SHARED_CREDENTIALS_FILE": "{home}/elsewhere", "AWS_EC2_METADATA_DISABLED": "true"}, home), "")
			assert moved.keys.accessKey == "AKIAELSE"
			kind = ErrorKind.Server
			findKeys(fakeSources(off, home), "nobody") onerror (err error) {
				kind = failureKind(err)
				recover Found{}
			}
			assert kind == ErrorKind.Denied
			// A profile that names a program to ask.
			try os.writeFile("{home}/.aws/config", "[profile vault]\ncredential_process = vault-helper --role dev\nregion = eu-west-2\n\n[profile broken]\ncredential_process = vault-helper --fail\n\n[profile absent]\ncredential_process = nothing-here\n".bytes())
			let asked = try findKeys(fakeSources(off, home), "vault")
			assert asked.keys.accessKey == "ASIAPROC" && asked.keys.token == "proc-token" && asked.region == "eu-west-2" && !(asked.renew is none)
			let ends = asked.keys.expires
			fail "no expiry" when ends is none
			for let profile in ["broken", "absent"] {
				kind = ErrorKind.Server
				findKeys(fakeSources(off, home), profile) onerror (err error) {
					kind = failureKind(err)
					recover Found{}
				}
				assert kind == ErrorKind.Denied
			}
			try os.remove(home, true)
		}

		// The real thing: a program run through the shell.
		@test()
		def TestCredentialProgram() !none {
			let keys = try processKeys(realSources().run, "printf '%s' '\{\"Version\":1,\"AccessKeyId\":\"ASIASHELL\",\"SecretAccessKey\":\"s\"}'")
			assert keys.accessKey == "ASIASHELL" && keys.token == "" && keys.expires is none
			let kind = ErrorKind.Server
			processKeys(realSources().run, "exit 4") onerror (err error) {
				kind = failureKind(err)
				recover Keys{}
			}
			assert kind == ErrorKind.Denied
		}

		@test()
		def TestMetadataServices() !none {
			let mux = new http.ServeMux()
			let until = time.now() + 6h
			let stamp = until.str(time.TimeFormat.RFC3339)
			try mux.handle("PUT /latest/api/token", def (ctx http.Context) !none {
				return ctx.text("imds-session")
			})
			try mux.handle("GET /latest/meta-data/iam/security-credentials/", def (ctx http.Context) !none {
				fail "no session token" when ctx.header("X-aws-ec2-metadata-token") != "imds-session"
				return ctx.text("machine-role\n")
			})
			try mux.handle("GET /latest/meta-data/iam/security-credentials/machine-role", def (ctx http.Context) !none {
				return ctx.text("\{\"Code\":\"Success\",\"AccessKeyId\":\"ASIAMACHINE\",\"SecretAccessKey\":\"machine-secret\",\"Token\":\"machine-token\",\"Expiration\":\"{stamp}\"}")
			})
			try mux.handle("GET /task", def (ctx http.Context) !none {
				if ctx.header("Authorization") != "task-bearer" {
					return ctx.text(403, "\{\"Code\":\"Denied\",\"Message\":\"no bearer\"}")
				}
				return ctx.text("\{\"AccessKeyId\":\"ASIATASK\",\"SecretAccessKey\":\"task-secret\",\"Token\":\"task-token\",\"Expiration\":\"{stamp}\"}")
			})
			let site = new httptest.Server(mux)
			try site.start()
			let base = "http://{site.address().str()}"
			let home = "/tmp/adm-s3-none-{time.now().unixNs()}"

			let machine = try findKeys(fakeSources({"AWS_EC2_METADATA_SERVICE_ENDPOINT": "{base}/"}, home), "")
			assert machine.keys.accessKey == "ASIAMACHINE" && machine.keys.secretKey == "machine-secret" && machine.keys.token == "machine-token"
			let ends = machine.keys.expires
			fail "no expiry" when ends is none
			assert ends - time.now() > 5h && !(machine.renew is none)

			let task = try findKeys(fakeSources({"AWS_CONTAINER_CREDENTIALS_FULL_URI": "{base}/task", "AWS_CONTAINER_AUTHORIZATION_TOKEN": "task-bearer", "AWS_REGION": "eu-north-1"}, home), "")
			assert task.keys.accessKey == "ASIATASK" && task.keys.token == "task-token" && task.region == "eu-north-1"
			let kind = ErrorKind.Server
			findKeys(fakeSources({"AWS_CONTAINER_CREDENTIALS_FULL_URI": "{base}/task"}, home), "") onerror (err error) {
				kind = failureKind(err)
				recover Found{}
			}
			assert kind == ErrorKind.Denied

			// A profile signed in through single sign-on: the cached token
			// has ended, so it is renewed first, then traded for keys.
			let ssoHome = "/tmp/adm-s3-sso-{time.now().unixNs()}"
			try os.mkdir("{ssoHome}/.aws/sso/cache", true)
			try os.writeFile("{ssoHome}/.aws/config", "[profile dev]\nsso_session = corp\nsso_account_id = 123456789012\nsso_role_name = Developer\nregion = eu-west-1\n\n[sso-session corp]\nsso_region = eu-central-1\nsso_start_url = https://corp.awsapps.com/start\n".bytes())
			// The cache file is named by the SHA-1 of the session's name.
			let cache = "{ssoHome}/.aws/sso/cache/{new hash.SHA1().hash("corp".bytes()).hex().lower()}.json"
			try os.writeFile(cache, "\{\"accessToken\":\"old-token\",\"expiresAt\":\"2020-01-01T00:00:00Z\",\"refreshToken\":\"refresh-1\",\"clientId\":\"client\",\"clientSecret\":\"secret\"}".bytes())
			try mux.handle("POST /token", def (ctx http.Context) !none {
				let asked = try ctx.text()
				fail "wrong refresh request" unless asked.contains("refresh-1") && asked.contains("refresh_token")
				return ctx.text("\{\"accessToken\":\"new-token\",\"refreshToken\":\"refresh-2\",\"expiresIn\":3600}")
			})
			try mux.handle("GET /federation/credentials", def (ctx http.Context) !none {
				if ctx.header("x-amz-sso_bearer_token") != "new-token" || ctx.query("role_name", "") != "Developer" || ctx.query("account_id", "") != "123456789012" {
					return ctx.text(401, "\{\"message\":\"bad token\"}")
				}
				return ctx.text("\{\"roleCredentials\":\{\"accessKeyId\":\"ASIASSO\",\"secretAccessKey\":\"sso-secret\",\"sessionToken\":\"sso-token\",\"expiration\":{(time.now() + 1h).unixNs() / 1000000}}}")
			})
			let sso = fakeSources({"AWS_EC2_METADATA_DISABLED": "true"}, ssoHome)
			sso.ssoPortal = base
			sso.ssoTokens = base
			let signedIn = try findKeys(sso, "dev")
			assert signedIn.keys.accessKey == "ASIASSO" && signedIn.keys.token == "sso-token" && signedIn.region == "eu-west-1"
			let lasts = signedIn.keys.expires
			fail "no expiry" when lasts is none
			assert lasts - time.now() > 50min
			let renewed = string(try os.readFile(cache))
			assert renewed.contains("new-token") && renewed.contains("refresh-2") && renewed.contains("client")
			// Signed out for good.
			try os.writeFile(cache, "\{\"accessToken\":\"old\",\"expiresAt\":\"2020-01-01T00:00:00Z\"}".bytes())
			kind = ErrorKind.Server
			let hint = ""
			findKeys(sso, "dev") onerror (err error) {
				kind = failureKind(err)
				hint = err.message
				recover Found{}
			}
			assert kind == ErrorKind.Denied && hint.contains("aws sso login")
			try os.remove(ssoHome, true)

			// An engine renews what is about to end, and keeps what is not.
			let engine = new Engine()
			let calls = 0
			engine.renew = def () !Keys {
				calls++
				return Keys{accessKey: "ASIANEXT{calls}", secretKey: "next", token: "t", expires: time.now() + 1h}
			}
			engine.adopt(Keys{accessKey: "ASIAOLD", secretKey: "old", token: "t", expires: time.now() + 2min})
			try engine.fresh()
			assert engine.current().accessKey == "ASIANEXT1" && calls == 1
			try engine.fresh()
			assert calls == 1
			// A renewal that fails is tolerated while the old ones last.
			engine.renew = def () !Keys {
				fail errorOf(ErrorKind.Connection, "s3: no answer")
			}
			engine.adopt(Keys{accessKey: "ASIASOON", secretKey: "s", token: "t", expires: time.now() + 1min})
			try engine.fresh()
			assert engine.current().accessKey == "ASIASOON"
			engine.adopt(Keys{accessKey: "ASIAGONE", secretKey: "s", token: "t", expires: time.now() - 1min})
			kind = ErrorKind.Server
			engine.fresh() onerror (err error) {
				kind = failureKind(err)
				recover none
			}
			assert kind == ErrorKind.Connection
			site.close() onerror recover none
		}

		@test()
		def TestAssumeRole() !none {
			return none when testStore == ""
			let store = try connect(testStore)
			let before = store.accessKey
			try store.assumeRole("arn:aws:iam::123456789012:role/adm-test", "adm-test-session", 15min)
			assert store.accessKey != before && store.accessKey != "" && !(store.sessionToken is none)
			// The temporary credentials work.
			assert (try store.buckets()).len() >= 0
			let kind = ErrorKind.Server
			store.assumeRole("arn:aws:iam::123456789012:role/adm-test", length = 1min) onerror (err error) {
				kind = failureKind(err)
				recover none
			}
			assert kind == ErrorKind.Argument
			let wrong = try connect(testStore.replace(/:[^:@\/]*@/, ":wrong-secret@"))
			kind = ErrorKind.Server
			wrong.assumeRole("arn:aws:iam::123456789012:role/adm-test") onerror (err error) {
				kind = failureKind(err)
				recover none
			}
			assert kind == ErrorKind.Denied
		}
	}
}
