// Where credentials come from when the application does not hold them:
// the environment, the files AWS tools keep, a token of the cluster the
// program runs in, the container's or the machine's metadata service,
// and roles taken through STS.
internal partial module adm.network.s3.wire {
	use (
		std.crypto.hash
		std.data.encoding
		std.data.encoding::(XMLNode)
		std.formats.data::(INI, INIFile, INISection)
		std.net.http
		std.net.url
		std.os
		std.services.runtime::(Runtime)
		std.time
		adm.network.s3::*
		adm.network.s3.sigv4::*
	)

	// Keys is one set of credentials. Temporary ones say when they end.
	struct Keys {
		accessKey string
		secretKey string
		token     string
		expires   ?time.Time
	}

	// Found is what a search for credentials gave: the keys, the region
	// that came with them ("" for none) and how to get the next ones when
	// they are temporary.
	struct Found {
		keys   Keys
		region string
		renew  ?def () !Keys
	}

	// Sources says where a search looks. Tests point it at files and
	// servers of their own.
	struct Sources {
		// Reads a variable of the environment; none when it is not set.
		env       def (string) ?string
		// The folder that holds `.aws`.
		home      string
		// How long a metadata service may take to answer: it is asked last,
		// and outside the cloud nothing answers at all.
		patience  duration
		// The addresses of AWS's sign-in services, for tests: "" for the
		// real ones of the profile's region.
		ssoPortal string
		ssoTokens string
		// Runs a command and returns what it printed and its exit code.
		run       def (string) !(string, int)
	}

	// The sources of a real program.
	def realSources() Sources {
		let home = os.homeDir() onerror recover ""
		return Sources{env: def (name string) ?string {
			return Runtime.getEnv(name)
		}, home: home, patience: 2s, run: def (command string) !(string, int) {
			let ran = try Runtime.run(command)
			return (ran.output, ran.code)
		}}
	}

	def envOf(from Sources, name string) string {
		let read = from.env
		let value = read(name)
		return value is none ?? ("", value)
	}

	// findKeys looks for credentials where AWS tools do, in their order:
	// the environment, a web identity token, the shared files (for
	// `profile`, or `AWS_PROFILE`, or `default`), the container's
	// credentials address, the instance metadata service.
	// Fails with an S3Error of ErrorKind.Denied when none of them has any,
	// naming what was tried.
	def findKeys(from Sources, profile string) !Found {
		let region = envOf(from, "AWS_REGION")
		region = envOf(from, "AWS_DEFAULT_REGION") when region == ""
		let tried string[] = []

		let id = envOf(from, "AWS_ACCESS_KEY_ID")
		let secret = envOf(from, "AWS_SECRET_ACCESS_KEY")
		if id != "" && secret != "" {
			return Found{keys: Keys{accessKey: id, secretKey: secret, token: envOf(from, "AWS_SESSION_TOKEN")}, region: region}
		}
		tried.push("AWS_ACCESS_KEY_ID")

		let name = profile
		name = envOf(from, "AWS_PROFILE") when name == ""
		name = "default" when name == ""
		let config = sharedFile(from, "AWS_CONFIG_FILE", "config")
		let stored = sharedFile(from, "AWS_SHARED_CREDENTIALS_FILE", "credentials")
		let settings = sectionOf(config, name, true)
		if region == "" && !(settings is none) {
			region = settings.string("region")
		}

		let tokenFile = envOf(from, "AWS_WEB_IDENTITY_TOKEN_FILE")
		let role = envOf(from, "AWS_ROLE_ARN")
		if tokenFile != "" && role != "" {
			let session = envOf(from, "AWS_ROLE_SESSION_NAME")
			session = "adm" when session == ""
			let endpoint = stsEndpoint(region)
			let renew = def () !Keys {
				return try webIdentityKeys(endpoint, role, session, tokenFile)
			}
			return Found{keys: try renew(), region: region, renew: renew}
		}
		tried.push("AWS_WEB_IDENTITY_TOKEN_FILE")

		for let section in [sectionOf(stored, name, false), settings] {
			continue when section is none
			let key = section.string("aws_access_key_id")
			continue when key == ""
			return Found{keys: Keys{accessKey: key, secretKey: section.string("aws_secret_access_key"), token: section.string("aws_session_token")}, region: region}
		}
		// A profile that takes a role with the keys of another profile.
		if !(settings is none) && settings.string("role_arn") != "" && settings.string("source_profile") != "" {
			let base = try findKeys(Sources{env: def (unused string) ?string {
				return none
			}, home: from.home, patience: from.patience}, settings.string("source_profile"))
			let endpoint = stsEndpoint(region)
			let roleArn = settings.string("role_arn")
			let session = settings.string("role_session_name", "adm")
			let external = settings.string("external_id")
			let signedFor = region == "" ?? ("us-east-1", region)
			let renew = def () !Keys {
				return try roleKeys(endpoint, signedFor, base.keys, roleArn, session, 1h, external, none)
			}
			return Found{keys: try renew(), region: region, renew: renew}
		}
		// A profile that names a program to ask.
		if !(settings is none) && settings.string("credential_process") != "" {
			let command = settings.string("credential_process")
			let run = from.run
			let renew = def () !Keys {
				return try processKeys(run, command)
			}
			return Found{keys: try renew(), region: region, renew: renew}
		}
		// A profile signed in with `aws sso login`.
		if !(settings is none) && settings.string("sso_account_id") != "" && settings.string("sso_role_name") != "" {
			let renew = def () !Keys {
				return try ssoKeys(from, config, settings)
			}
			return Found{keys: try renew(), region: region, renew: renew}
		}
		tried.push("the profile '{name}' in {from.home}/.aws")

		let relative = envOf(from, "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI")
		let full = envOf(from, "AWS_CONTAINER_CREDENTIALS_FULL_URI")
		if relative != "" || full != "" {
			let address = relative != "" ?? ("http://169.254.170.2{relative}", full)
			let bearer = envOf(from, "AWS_CONTAINER_AUTHORIZATION_TOKEN")
			let bearerFile = envOf(from, "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE")
			let patience = from.patience
			let renew = def () !Keys {
				return try containerKeys(address, bearer, bearerFile, patience)
			}
			return Found{keys: try renew(), region: region, renew: renew}
		}
		tried.push("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI")

		if envOf(from, "AWS_EC2_METADATA_DISABLED").lower() != "true" {
			let imds = envOf(from, "AWS_EC2_METADATA_SERVICE_ENDPOINT")
			imds = "http://169.254.169.254" when imds == ""
			imds = imds.slice(0, imds.len() - 1) when imds.endsWith("/")
			let patience = from.patience
			let renew = def () !Keys {
				return try instanceKeys(imds, patience)
			}
			let failed = false
			let keys = renew() onerror (err error) {
				failed = true
				recover Keys{}
			}
			return Found{keys: keys, region: region, renew: renew} unless failed
			tried.push("the instance metadata service at {imds}")
		}
		fail errorOf(ErrorKind.Denied, "s3: no credentials found; tried {tried.join(", ")}")
	}

	// One of the two shared files, parsed; none when it does not exist or
	// is not such a file.
	def sharedFile(from Sources, variable string, name string) ?INIFile {
		let path = envOf(from, variable)
		path = "{from.home}/.aws/{name}" when path == ""
		let data = os.readFile(path) onerror recover byte[]
		return none when data.len() == 0
		return parsedFile(string(data)) onerror recover none
	}

	def parsedFile(text string) !?INIFile {
		return try new INI().parse(text)
	}

	// A profile's section: `[name]` in the credentials file, and in the
	// config file `[profile name]`, or `[default]` for the default one.
	def sectionOf(file ?INIFile, name string, config bool) ?INISection {
		return none when file is none
		if config && name != "default" {
			let section = file.section("profile {name}")
			return section unless section is none
		}
		return file.section(name)
	}

	// The STS endpoint of a region; the global one without a region.
	def stsEndpoint(region string) string {
		return "https://sts.amazonaws.com" when region == ""
		return "https://sts.{region}.amazonaws.com"
	}

	// Sends a request that carries credentials back and returns the body
	// of its reply.
	// Fails with an S3Error: ErrorKind.Connection when nothing answers,
	// ErrorKind.Denied for any reply that is not a success.
	def fetchKeys(req http.Request, patience duration, about string, transport ?http.RoundTripper = none) !byte[] {
		let web = new http.Client()
		web.timeout = patience
		web.transport = transport
		let res = web.do(req) onerror (err error) {
			fail errorOf(ErrorKind.Connection, "s3: {about}: {err.message}", err)
		}
		let body = res.bytes() onerror (err error) {
			fail errorOf(ErrorKind.Connection, "s3: {about}: {err.message}", err)
		}
		if res.status < 200 || res.status >= 300 {
			let said = string(body)
			let root = parsedOrNone(new encoding.XML(), body) onerror recover none
			if !(root is none) {
				let message = deepText(root, "Message")
				said = "{deepText(root, "Code")}: {message}" when message != ""
			}
			fail errorOf(ErrorKind.Denied, "s3: {about}: status {res.status}: {said.slice(0, said.len() < 300 ?? (said.len(), 300))}")
		}
		return body
	}

	def requestTo(method string, address string, about string) !http.Request {
		let target = url.parse(address) onerror (err error) {
			fail errorOf(ErrorKind.Argument, "s3: {about}: '{address}' is not an address: {err.message}", err)
		}
		return http.newRequest(http.parseMethod(method), target) onerror (err error) {
			fail errorOf(ErrorKind.Argument, "s3: {about}: {err.message}", err)
		}
	}

	// The text of the first element with a name anywhere under a node.
	def deepText(node XMLNode, name string) string {
		for let child in node.children {
			return child.text() when child.name == name
			let below = deepText(child, name)
			return below when below != ""
		}
		return ""
	}

	// The credentials in the reply of an STS call.
	def keysInDocument(body byte[], about string) !Keys {
		let root = parsedOrNone(new encoding.XML(), body) onerror recover none
		fail errorOf(ErrorKind.Protocol, "s3: {about}: the reply is not XML") when root is none
		let keys = Keys{accessKey: deepText(root, "AccessKeyId"), secretKey: deepText(root, "SecretAccessKey"), token: deepText(root, "SessionToken")}
		fail errorOf(ErrorKind.Protocol, "s3: {about}: the reply holds no credentials") when keys.accessKey == "" || keys.secretKey == ""
		let until = deepText(root, "Expiration")
		keys.expires = readTime(until) when until != ""
		return keys
	}

	// The credentials in the JSON a metadata service answers with.
	def keysInJSON(body byte[], about string) !Keys {
		let parsed = new encoding.JSON().parse(body) onerror (err error) {
			fail errorOf(ErrorKind.Protocol, "s3: {about}: the reply is not JSON: {err.message}", err)
		}
		let fields map<string, any> = {}
		match parsed {
			case map<string, any>:
				fields = parsed
			default:
				fail errorOf(ErrorKind.Protocol, "s3: {about}: the reply is not a JSON object")
		}
		let keys = Keys{accessKey: jsonText(fields, "AccessKeyId"), secretKey: jsonText(fields, "SecretAccessKey"), token: jsonText(fields, "Token")}
		// A credential program calls it SessionToken.
		keys.token = jsonText(fields, "SessionToken") when keys.token == ""
		fail errorOf(ErrorKind.Denied, "s3: {about}: the reply holds no credentials ({jsonText(fields, "Code")} {jsonText(fields, "Message")})") when keys.accessKey == "" || keys.secretKey == ""
		let until = jsonText(fields, "Expiration")
		keys.expires = readTime(until) when until != ""
		return keys
	}

	def jsonText(fields map<string, any>, name string) string {
		let value = fields.get(name)
		match value {
			case string:
				return value
			default:
				return ""
		}
	}

	def formEncode(fields Field[]) byte[] {
		let parts string[] = []
		for let f in fields {
			parts.push("{uriEncode(f.name)}={uriEncode(f.value)}") when f.value != ""
		}
		return parts.join("&").bytes()
	}

	// roleKeys asks STS for the temporary credentials of a role, signing
	// with the keys given.
	// Fails with an S3Error: ErrorKind.Denied when STS refuses,
	// ErrorKind.Connection when it does not answer.
	def roleKeys(endpoint string, region string, with Keys, role string, session string, length duration, externalId string, transport ?http.RoundTripper) !Keys {
		let about = "taking the role {role}"
		let body = formEncode([Field{name:"Action", value:"AssumeRole"}, Field{name:"Version", value:"2011-06-15"}, Field{name:"RoleArn", value:role}, Field{name:"RoleSessionName", value:session}, Field{name:"DurationSeconds", value:(int64(length) / 1000000000).str()}, Field{name:"ExternalId", value:externalId}])
		let req = try requestTo("POST", endpoint, about)
		let amzDate = amzDateOf(time.now())
		let digest = sha256Hex(body)
		let host = req.url.host
		let headers Field[] = [Field{name:"Host", value:host}, Field{name:"x-amz-date", value:amzDate}, Field{name:"Content-Type", value:"application/x-www-form-urlencoded"}, Field{name:"x-amz-content-sha256", value:digest}]
		headers.push(Field{name: "x-amz-security-token", value: with.token}) when with.token != ""
		let signer = Signer{accessKey: with.accessKey, secretKey: with.secretKey, token: with.token, region: region, product: "sts"}
		let stamp = try sign(signer, "POST", "/", "", headers, digest, amzDate)
		for let h in headers {
			req.headers.add(h.name, h.value) unless h.name == "Host"
		}
		req.headers.set("Authorization", stamp.authorization)
		req.replaceBody(body)
		return try keysInDocument(try fetchKeys(req, 30s, about, transport), about)
	}

	// webIdentityKeys trades the token a cluster gave the program (a
	// Kubernetes service account's) for the credentials of a role.
	// Fails as `roleKeys` does, and with ErrorKind.Denied when the token
	// file cannot be read.
	def webIdentityKeys(endpoint string, role string, session string, tokenFile string) !Keys {
		let about = "taking the role {role} with a web identity"
		let token = os.readFile(tokenFile) onerror (err error) {
			fail errorOf(ErrorKind.Denied, "s3: {about}: {tokenFile}: {err.message}", err)
		}
		let body = formEncode([Field{name:"Action", value:"AssumeRoleWithWebIdentity"}, Field{name:"Version", value:"2011-06-15"}, Field{name:"RoleArn", value:role}, Field{name:"RoleSessionName", value:session}, Field{name:"WebIdentityToken", value:string(token).trim()}])
		let req = try requestTo("POST", endpoint, about)
		req.headers.set("Content-Type", "application/x-www-form-urlencoded")
		req.replaceBody(body)
		return try keysInDocument(try fetchKeys(req, 30s, about), about)
	}

	// containerKeys asks the address a container platform (ECS, EKS pod
	// identity) gives its tasks.
	// Fails as `fetchKeys` and `keysInJSON` do.
	def containerKeys(address string, bearer string, bearerFile string, patience duration) !Keys {
		let about = "the container's credentials at {address}"
		let req = try requestTo("GET", address, about)
		let word = bearer
		if bearerFile != "" {
			let held = os.readFile(bearerFile) onerror (err error) {
				fail errorOf(ErrorKind.Denied, "s3: {about}: {bearerFile}: {err.message}", err)
			}
			word = string(held).trim()
		}
		req.headers.set("Authorization", word) when word != ""
		return try keysInJSON(try fetchKeys(req, patience, about), about)
	}

	// instanceKeys asks the metadata service of a cloud machine (IMDSv2)
	// for the credentials of the role the machine runs as.
	// Fails as `fetchKeys` and `keysInJSON` do.
	def instanceKeys(imds string, patience duration) !Keys {
		let about = "the instance metadata service at {imds}"
		let ask = try requestTo("PUT", "{imds}/latest/api/token", about)
		ask.headers.set("X-aws-ec2-metadata-token-ttl-seconds", "21600")
		let session = string(try fetchKeys(ask, patience, about)).trim()
		let list = try requestTo("GET", "{imds}/latest/meta-data/iam/security-credentials/", about)
		list.headers.set("X-aws-ec2-metadata-token", session)
		let role = string(try fetchKeys(list, patience, about)).trim().split("\n")[0].trim()
		fail errorOf(ErrorKind.Denied, "s3: {about}: the machine has no role") when role == ""
		let get = try requestTo("GET", "{imds}/latest/meta-data/iam/security-credentials/{role}", about)
		get.headers.set("X-aws-ec2-metadata-token", session)
		return try keysInJSON(try fetchKeys(get, patience, about), about)
	}

	// processKeys runs the program a profile names with
	// `credential_process` and reads the credentials it prints.
	// Fails with an S3Error of ErrorKind.Denied when the program cannot be
	// run (the policy may refuse it), exits with an error, or prints no
	// credentials.
	def processKeys(run def (string) !(string, int), command string) !Keys {
		let about = "the credential program of the profile"
		let (output, code) = run(command) onerror (err error) {
			fail errorOf(ErrorKind.Denied, "s3: {about} could not be run: {err.message}", err)
		}
		fail errorOf(ErrorKind.Denied, "s3: {about} exited with {code}") when code != 0
		return try keysInJSON(output.bytes(), about)
	}

	// ssoKeys trades the token `aws sso login` left in `~/.aws/sso/cache`
	// for the credentials of the profile's account and role, getting a new
	// token first when that one has ended and the sign-in can be renewed.
	// Fails with an S3Error: ErrorKind.Denied when there is no token, or
	// it has ended for good (sign in again with `aws sso login`), or the
	// portal refuses; ErrorKind.Connection when the portal does not answer.
	def ssoKeys(from Sources, config ?INIFile, settings INISection) !Keys {
		let about = "the single sign-on of account {settings.string("sso_account_id")}"
		let session = settings.string("sso_session")
		let ssoRegion = settings.string("sso_region")
		let cacheKey = settings.string("sso_start_url")
		if session != "" && !(config is none) {
			let shared = config.section("sso-session {session}")
			if !(shared is none) {
				ssoRegion = shared.string("sso_region", ssoRegion)
			}
			cacheKey = session
		}
		fail errorOf(ErrorKind.Denied, "s3: {about}: the profile names no sso_region") when ssoRegion == ""
		let path = "{from.home}/.aws/sso/cache/{new hash.SHA1().hash(cacheKey.bytes()).hex().lower()}.json"
		let stored = os.readFile(path) onerror (err error) {
			fail errorOf(ErrorKind.Denied, "s3: {about}: not signed in ({path} is missing); run `aws sso login`", err)
		}
		let parsed = new encoding.JSON().parse(stored) onerror (err error) {
			fail errorOf(ErrorKind.Denied, "s3: {about}: {path} is not JSON; run `aws sso login`", err)
		}
		let token map<string, any> = {}
		match parsed {
			case map<string, any>:
				token = parsed
			default:
				fail errorOf(ErrorKind.Denied, "s3: {about}: {path} holds no token; run `aws sso login`")
		}
		let access = jsonText(token, "accessToken")
		let until = jsonText(token, "expiresAt")
		let ended = until == "" || readTime(until) - time.now() < 1min
		if ended {
			// The sign-in itself lasts longer than its token: a new token
			// for the asking, kept where the AWS tools look for it.
			let refresh = jsonText(token, "refreshToken")
			fail errorOf(ErrorKind.Denied, "s3: {about}: the sign-in has ended; run `aws sso login`") when refresh == "" || jsonText(token, "clientId") == ""
			let endpoint = from.ssoTokens == "" ?? ("https://oidc.{ssoRegion}.amazonaws.com", from.ssoTokens)
			let ask = try requestTo("POST", "{endpoint}/token", about)
			ask.headers.set("Content-Type", "application/json")
			let wish map<string, any> = {"grantType": "refresh_token", "clientId": jsonText(token, "clientId"), "clientSecret": jsonText(token, "clientSecret"), "refreshToken": refresh}
			ask.replaceBody(new encoding.JSON().encode(wish))
			let fresh = new encoding.JSON().parse(try fetchKeys(ask, 30s, about)) onerror (err error) {
				fail errorOf(ErrorKind.Protocol, "s3: {about}: the token service did not answer in JSON", err)
			}
			match fresh {
				case map<string, any>:
					access = jsonText(fresh, "accessToken")
					token["accessToken"] = access
					let next = jsonText(fresh, "refreshToken")
					token["refreshToken"] = next when next != ""
					let seconds = fresh.get("expiresIn")
					let lasts = 3600
					match seconds {
						case int:
							lasts = seconds
						case float:
							lasts = int(seconds)
						default:
					}
					token["expiresAt"] = (time.now() + duration(int64(lasts) * 1000000000)).str(time.TimeFormat.RFC3339)
				default:
			}
			fail errorOf(ErrorKind.Denied, "s3: {about}: the sign-in could not be renewed; run `aws sso login`") when access == ""
			os.writeFile(path, new encoding.JSON().encode(token)) onerror recover none
		}
		let portal = from.ssoPortal == "" ?? ("https://portal.sso.{ssoRegion}.amazonaws.com", from.ssoPortal)
		let get = try requestTo("GET", "{portal}/federation/credentials?role_name={uriEncode(settings.string("sso_role_name"))}&account_id={uriEncode(settings.string("sso_account_id"))}", about)
		get.headers.set("x-amz-sso_bearer_token", access)
		let answer = new encoding.JSON().parse(try fetchKeys(get, 30s, about)) onerror (err error) {
			fail errorOf(ErrorKind.Protocol, "s3: {about}: the portal did not answer in JSON", err)
		}
		let role map<string, any> = {}
		match answer {
			case map<string, any>:
				let inner = answer.get("roleCredentials")
				match inner {
					case map<string, any>:
						role = inner
					default:
				}
			default:
		}
		let keys = Keys{accessKey: jsonText(role, "accessKeyId"), secretKey: jsonText(role, "secretAccessKey"), token: jsonText(role, "sessionToken")}
		fail errorOf(ErrorKind.Protocol, "s3: {about}: the portal's answer holds no credentials") when keys.accessKey == "" || keys.secretKey == ""
		let ends = role.get("expiration")
		match ends {
			case int:
				keys.expires = time.fromUnixNs(int64(ends) * 1000000)
			case float:
				keys.expires = time.fromUnixNs(int64(ends) * 1000000)
			default:
		}
		return keys
	}
}
