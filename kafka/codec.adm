// How values travel in the Kafka protocol (the versions before the
// "flexible" ones): integers big-endian, strings and byte strings with
// their length in front, zigzag varints inside record batches.
internal partial module adm.network.kafka.wire {
	use adm.network.kafka::*

	// errorOf builds the KafkaError the library fails with.
	def errorOf(kind ErrorKind, message string, errorCode int = 0) KafkaError {
		return KafkaError{message: message, code: kind.value, kind: kind, errorCode: errorCode}
	}

	// Encoder appends fields to a request.
	type Encoder {
		data byte[] = []

		def new() {}

		def i8(v int) {
			data.push(byte(v & 0xFF))
		}

		def bool(v bool) {
			data.push(byte(v ?? (1, 0)))
		}

		def i16(v int) {
			data.push(byte((v >> 8) & 0xFF), byte(v & 0xFF))
		}

		def i32(v int) {
			data.push(byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF))
		}

		def i64(v int) {
			i32((v >> 32) & 0xFFFFFFFF)
			i32(v & 0xFFFFFFFF)
		}

		def text(v string) {
			let raw = v.bytes()
			i16(raw.len())
			data.push(...raw)
		}

		// A string that may be absent.
		def maybe(v ?string) {
			if v is none {
				i16(-1)
			} else {
				text(v)
			}
		}

		def bytes(v byte[]) {
			i32(v.len())
			data.push(...v)
		}

		def raw(v byte[]) {
			data.push(...v)
		}

		// The count that opens an array.
		def count(n int) {
			i32(n)
		}

		def texts(items string[]) {
			i32(items.len())
			for let item in items {
				text(item)
			}
		}

		def ints(items int[]) {
			i32(items.len())
			for let item in items {
				i32(item)
			}
		}

		// A signed integer as a zigzag varint.
		def varint(v int) {
			let u = uint64((v << 1) ^ (v >> 63))
			for u >= uint64(0x80) {
				data.push(byte(int(u & uint64(0x7F)) | 0x80))
				u = u >> 7
			}
			data.push(byte(int(u)))
		}

		// The fields of the "flexible" request versions: lengths and counts
		// as unsigned varints of one more than their value (0 for none),
		// and a list of tagged fields, always empty here, after each
		// structure.
		def uvarint(v int) {
			let u = uint64(v)
			for u >= uint64(0x80) {
				data.push(byte(int(u & uint64(0x7F)) | 0x80))
				u = u >> 7
			}
			data.push(byte(int(u)))
		}

		def ctext(v string) {
			let raw = v.bytes()
			uvarint(raw.len() + 1)
			data.push(...raw)
		}

		def cmaybe(v ?string) {
			if v is none {
				uvarint(0)
			} else {
				ctext(v)
			}
		}

		def ccount(n int) {
			uvarint(n + 1)
		}

		// A topic id: sixteen bytes, given as 32 hex digits.
		def uuid(hex string) {
			for let i = 0; i < 16; i++ {
				data.push(byte(hex.slice(i * 2, i * 2 + 2).toInt<int>(16)))
			}
		}

		def tagged() {
			data.push(byte(0))
		}

		// Bytes with their length as a varint; -1 for none.
		def varbytes(v ?byte[]) {
			if v is none {
				varint(-1)
			} else {
				varint(v.len())
				data.push(...v)
			}
		}
	}

	// Decoder reads fields from a response.
	type Decoder {
		data byte[]
		at   int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def left() int {
			return data.len() - at
		}

		// Fails with ErrorKind.Protocol when the data ends first.
		def need(count int) !none {
			fail errorOf(ErrorKind.Protocol, "kafka: a message ends in the middle of a field") when count < 0 || at + count > data.len()
			return none
		}

		def i8() !int {
			try need(1)
			at++
			let v = int(data[at - 1])
			return v >= 0x80 ?? (v - 0x100, v)
		}

		def bool() !bool {
			return (try i8()) != 0
		}

		def i16() !int {
			try need(2)
			at += 2
			let v = (int(data[at - 2]) << 8) | int(data[at - 1])
			return v >= 0x8000 ?? (v - 0x10000, v)
		}

		def i32() !int {
			try need(4)
			at += 4
			let v = (int(data[at - 4]) << 24) | (int(data[at - 3]) << 16) | (int(data[at - 2]) << 8) | int(data[at - 1])
			return v >= 0x80000000 ?? (v - 0x100000000, v)
		}

		def u32() !int {
			try need(4)
			at += 4
			return (int(data[at - 4]) << 24) | (int(data[at - 3]) << 16) | (int(data[at - 2]) << 8) | int(data[at - 1])
		}

		def i64() !int {
			let high = try u32()
			let low = try u32()
			return (high << 32) | low
		}

		def text() !string {
			let size = try i16()
			return "" when size < 0
			try need(size)
			at += size
			return string(data[at - size:at])
		}

		def maybe() !?string {
			let size = try i16()
			return none when size < 0
			try need(size)
			at += size
			return string(data[at - size:at])
		}

		// A byte string; an absent one reads as empty.
		def bytes() !byte[] {
			let size = try i32()
			return [] when size < 0
			try need(size)
			at += size
			return data[at - size:at].clone()
		}

		def take(size int) !byte[] {
			try need(size)
			at += size
			return data[at - size:at]
		}

		// The count that opens an array; an absent array has none.
		def count() !int {
			let n = try i32()
			return 0 when n < 0
			fail errorOf(ErrorKind.Protocol, "kafka: an array of {n} items in {left()} bytes") when n > left()
			return n
		}

		def texts() !string[] {
			let out string[] = []
			for let n = try count(); n > 0; n-- {
				out.push(try text())
			}
			return out
		}

		def ints() !int[] {
			let out int[] = []
			for let n = try count(); n > 0; n-- {
				out.push(try i32())
			}
			return out
		}

		def varint() !int {
			let u = uint64(0)
			let shift = 0
			for {
				try need(1)
				let b = int(data[at])
				at++
				u = u | (uint64(b & 0x7F) << shift)
				break when b & 0x80 == 0
				shift += 7
				fail errorOf(ErrorKind.Protocol, "kafka: a varint longer than ten bytes") when shift > 63
			}
			let half = int(u >> 1)
			return u & uint64(1) == uint64(1) ?? (-half - 1, half)
		}

		def uvarint() !int {
			let u = uint64(0)
			let shift = 0
			for {
				try need(1)
				let b = int(data[at])
				at++
				u = u | (uint64(b & 0x7F) << shift)
				break when b & 0x80 == 0
				shift += 7
				fail errorOf(ErrorKind.Protocol, "kafka: a varint longer than ten bytes") when shift > 63
			}
			return int(u)
		}

		def cmaybe() !?string {
			let size = (try uvarint()) - 1
			return none when size < 0
			try need(size)
			at += size
			return string(data[at - size:at])
		}

		def ctext() !string {
			let v = try cmaybe()
			return v is none ?? ("", v)
		}

		// The count of a compact array; an absent one has none.
		def ccount() !int {
			let n = (try uvarint()) - 1
			return 0 when n < 0
			fail errorOf(ErrorKind.Protocol, "kafka: an array of {n} items in {left()} bytes") when n > left()
			return n
		}

		def uuid() !string {
			return (try take(16)).hex().lower()
		}

		// Passes over the tagged fields that close a structure.
		def tagged() !none {
			for let n = try uvarint(); n > 0; n-- {
				try uvarint()
				try take(try uvarint())
			}
			return none
		}

		def varbytes() !?byte[] {
			let size = try varint()
			return none when size < 0
			try need(size)
			at += size
			return data[at - size:at].clone()
		}
	}
}
